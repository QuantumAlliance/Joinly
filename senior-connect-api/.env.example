# App
PORT=5000
NODE_ENV=development
API_PREFIX=api/v1

# Database (MongoDB)
# Local dev: single-node replica set via docker-compose (transactions need one).
#   docker compose up -d
# Hosted (Atlas) instead: set MONGODB_URI and the DB_* vars are ignored.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/arooby?retryWrites=true&w=majority
DB_HOST=localhost
DB_PORT=27018
DB_DATABASE=arooby

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MINUTES=5

# SMTP (optional - OTP is logged to console when not configured)
# For Gmail, SMTP_PASSWORD must be a 16-char App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From address shown to recipients. Display name is always "Joinly".
EMAIL_FROM=

# Twilio SMS (optional - phone OTP is logged to console when not configured)
# Phone is a first-class login identifier: /auth/phone/request-otp sends the
# code through here. Leave blank for local development and read the code from
# the server console ("[DEV] OTP for +41...").
# Set either TWILIO_FROM_NUMBER (a number you own, E.164) or, preferably,
# TWILIO_MESSAGING_SERVICE_SID (handles sender pools and per-country rules).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# OTP rate limits (optional - sensible defaults are built in)
# SMS costs real money per message, so its budget is far tighter than email's.
# Raise the per-IP caps ONLY for local development: a full `npm run test:all`
# registers ~23 accounts from one host, which the shipped 100/hour email cap
# allows about four times an hour. Never raise them in a deployed environment.
# OTP_EMAIL_MAX_PER_IP_HOUR=2000
# OTP_EMAIL_MAX_PER_IP_DAY=8000
# OTP_SMS_MAX_PER_IP_HOUR=2000
# OTP_SMS_MAX_PER_IP_DAY=8000
# Raise only the per-IP caps for the harness. Leave the cooldown and the
# per-identifier budgets alone -- the phone suite asserts on the cooldown.
# OTP_SMS_MAX_PER_IDENTIFIER_HOUR=3
# OTP_EMAIL_MAX_PER_IDENTIFIER_HOUR=5

# Uploads (Cloudinary — get from your Cloudinary dashboard's "API Environment variable")
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
