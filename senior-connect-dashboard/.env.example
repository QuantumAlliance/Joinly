# Base URL of the NestJS API, including the global prefix.
# Local: the API's own .env sets PORT, and the Postman collection assumes 5000.
VITE_API_URL=http://localhost:5000/api/v1

# Run with the in-memory backend in src/mocks instead of the API — no server,
# no database. Strictly opt-in: anything other than "true" uses VITE_API_URL.
VITE_USE_MOCKS=false

# Deploying: the API allows every origin while its own CORS_ORIGINS is unset,
# but a deployed API must list this dashboard's origin, e.g.
#   CORS_ORIGINS=https://senior-connect-dashboard.vercel.app
# or the browser blocks every request.
